# Copie este arquivo para .streamlit/secrets.toml (uso local) e preencha, OU cole o
# mesmo conteúdo em Settings > Secrets no painel do Streamlit Community Cloud.
#
# Sem essa variável, o app usa SQLite local automaticamente (data/app.db) — bom pra
# testar na sua máquina. Para publicar (Streamlit Cloud), é obrigatório configurar um
# Postgres externo aqui, porque o disco do Streamlit Cloud não é persistente.
#
# Gratuito e recomendado: crie um projeto em https://supabase.com (ou https://neon.tech),
# copie a "Connection string" (URI) do banco e cole abaixo.

DATABASE_URL = "postgresql://postgres:SUA_SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"
